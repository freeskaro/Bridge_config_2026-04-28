% abut_soil_config_4AI.pl
%['C:/Users/rerfani/Documents/Prolog/abutment config 2023-03-02 - Claude/abut_soil_config_5'].
% Abutment soil configuration module.
% Builds a geometric profile from soil strata and sizes retaining elements.
%
% Soil facts format: soil(Type, Density, TopElev)
%
% TODO:
%   - Modularize further
%   - Check bearing capacity
%   - Enforce no slope below retained layer

:- use_module(library(lists), [reverse/2]).
:- use_module('abut_tree_gravity', [design_wall/9]).
:- consult('abut_config_facts').


% ============================================================
% Soil Data
% ============================================================

soil(gravel, loose,  100).
soil(gravel, loose,  98).
soil(gravel, loose,   96).
soil(rock,   sound,   94).

surface(100).
bottom(92).


% ============================================================
% Helpers
% ============================================================

% strip_keys(+Pairs, -Values)
% Remove keys from a keysorted list of Key-Value pairs.
strip_keys([], []).
strip_keys([_-V | T], [V | TT]) :-
    strip_keys(T, TT).

% build_list(-SortedLayers)
% Collect all soil/3 facts and sort by elevation ascending (bottom to top).
build_list(L) :-
    findall(Elev-soil(Type, Density, Elev), soil(Type, Density, Elev), Pairs),
    keysort(Pairs, Sorted),
    strip_keys(Sorted, L).


% ============================================================
% Main Entry Point
% ============================================================

% abut_geom(-Profile, -PropElem)
%
% Steps:
%   1. Compile soil strata into a sorted layer list.
%   2. Derive geometric configuration per layer (vertical / slope / confined).
%   3. Compile structural elements from the profile.
%   4. Size / proportion structural elements.
%
abut_geom(Profile, PropElem) :-
    build_list(L),
    bottom(BottomElev),
    iter_depth(L, BottomElev, 0, none, [[0, BottomElev, bottom]], Profile, _Pcon, _Pslp),
    embankment_elements(Profile, _, _ElemAcc, AbutElem),
    writeln('compiled embankment elements!'),
    design_retain(AbutElem, PropElem),
    writeln('designed embankment elements!').


% ============================================================
% Layer Configuration (bottom to top)
% ============================================================

% iter_depth(+Layers, +CurrElev, +CurrX, +PrevAType, +Accum, -Profile, -Pcon, -Pslp)
%
% Termination: add surface at final X position

iter_depth([], _, CurrX, _, Accum, Profile, _Pcon, _Pslp) :-
    surface(SurfaceElev),
    Profile = [[CurrX, SurfaceElev, surface] | Accum].

% Recursive case: process one layer and advance.
iter_depth([soil(Type, _, Elev) | Tail], CurrElev, CurrX, PrevAType, Accum,
           Profile, Pcon, Pslp) :-
    Height is Elev - CurrElev,
    layer_config(Type, Height, CurrX, NewX, PrevAType, AType, Pcon, Pslp),
    NewAccum = [[NewX, Elev, AType] | Accum],
    iter_depth(Tail, Elev, NewX, AType, NewAccum, Profile, Pcon, Pslp).


% layer_config(+Type, +Height, +X1, -X2, +PrevAType, -AType, ?Pcon, ?Pslp)
%
% Rock is always vertical; X does not change.
layer_config(rock, _, X, X, _, vertical, _, _).

% Gravel: configuration depends on prior history flags (Pcon / Pslp).
layer_config(gravel, Height, X1, X2, PrevAType, AType, Pcon, Pslp) :-
    (   Pcon == true, PrevAType == confined ->
            ( AType = slope,    X2 is X1 - 2*Height
            ; AType = confined, X2 is X1 )

    ;   Pcon == true, PrevAType == slope ->
            ( AType = slope, X2 is X1 - 2*Height )

    ;   Pslp == true, PrevAType == slope ->
            ( AType = slope,    X2 is X1 - 2*Height
            ; AType = confined, X2 is X1 )

    ;   Pslp == true, PrevAType == confined ->
            ( AType = confined, X2 is X1 )

    ;   % No prior history -- choose slope or confined and set the flag.
        ( AType = slope,    X2 is X1 - 2*Height, Pslp = true
        ; AType = confined, X2 is X1,             Pcon = true )
    ).


% ============================================================
% Structural Element Compilation
% ============================================================
%
% Element format: elem(Type, Bot_X, Bot_Elev, Top_X, Top_Elev)
%
% embankment_elements(+Profile, +PrevAType, +ElemAcc, -AbutElem)

% Surface node -- restart accumulator and recurse.

embankment_elements([ProfH | ProfT], _, _ElemAcc, AbutElem) :-
    ProfH = [_, _, surface],
    embankment_elements(ProfT, _, [], AbutElem).

% Bottom node -- accumulator is the final result.
embankment_elements([[_, _, bottom]], _, ElemAcc, ElemAcc).

% Interior node -- compile element for this layer, then recurse.
embankment_elements([ProfH | ProfT], PrevAType, ElemAcc, AbutElem) :-
    ProfH = [X, Y, AType],
    compile_elem([X, Y, AType], PrevAType, PrevLay, ElemAcc, ElemAcc2),
    embankment_elements(ProfT, PrevLay, ElemAcc2, AbutElem).


% compile_elem(+Layer, +PrevAType, -PrevLay, +ElemAccIn, -ElemAccOut)

% First element (empty accumulator).
compile_elem([X, Y, AType], _, AType, [], [elem(Elem, bot_x, _BotElev, X, Y)]) :-
    elem_type(AType, Elem).

% Same type as previous layer -- extend the bottom of the existing top element.
compile_elem([X, Y, AType], PrevAType, AType, [EH | ET], [EH2 | ET]) :-
    PrevAType == AType,
    EH  = elem(Elem, _BotX, _BotElev, TopX, TopElev),
    EH2 = elem(Elem,     X,        Y, TopX, TopElev).

% Different type -- update previous element's bottom, then open a new element.
compile_elem([X, Y, AType], PrevAType, AType, [EH | ET], [AElem, EH2 | ET]) :-
    PrevAType \== AType,
    EH  = elem(ElemO, _BotX, _BotElev, TopXO, TopElevO),
    EH2 = elem(ElemO,     X,        Y, TopXO, TopElevO),
    elem_type(AType, Elem),
    AElem = elem(Elem, bot_x, _NewBot, X, Y).


% ============================================================
% Retaining Wall Sizing
% ============================================================

% design_retain(+AbutElem, -PropElem)
design_retain(AbutElem, PropElem) :-
    design_retain_aux(AbutElem, [], RevPropElem),
    reverse(RevPropElem, PropElem).

design_retain_aux([], Acc, Acc).

design_retain_aux([Head | Tail], Acc, Result) :-
    Head = elem(Elem, _BotX, _BotElev, _X, _Y),
    ( Acc == []         -> Below = bottom
    ; Acc = [Prev | _],  Prev = elem(Below, _, _, _, _)
    ),
    ( Elem == retainment ->
        ( Tail == []          -> Above = none
        ; Tail = [Next | _],   Above = Next
        ),
        wall_design(Above, _H, _B, _W, _SumM, _E, Head, Below, Processed),
        design_retain_aux(Tail, [Processed | Acc], Result)
    ;
        design_retain_aux(Tail, [Head | Acc], Result)
    ).


% wall_design(+Above, -H, -B, -W, -SumM, -E, +Curr, +Below, -Processed)
wall_design(Above, H, B, W, SumM, E, Curr, Below, Processed) :-
    Curr = elem(Elem, BotX, BotElev, X, Y),
    ( Above = elem(ElemAbove, _, _, _, _) -> Elem1 = ElemAbove ; Elem1 = flat ),
    H is Y - BotElev,
    design_wall(Elem1, Below, Y, BotElev, H, B, W, SumM, E),
    X2 is X - B,
    Processed = elem(Elem, BotX, BotElev, X2, Y).