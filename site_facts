% site_facts
%
% Bridge location and project-specific facts.
% Edit this file to reconfigure for a different site.
%
% Contents:
%   - Borehole / soil log data
%   - Site geometry and hydraulic constraints
%   - Unit weights for retained soil and concrete
%   - Retaining wall type selection rules
%   - Pile design parameters and layout constraints

% ============================================================
% Soil Log  (borehole data, elevation in m)
% ============================================================

soil_log1(gravel, loose,  100.0).
soil_log1(rock,   sound,   85.0).

% ============================================================
% Site Geometry and Hydraulic Data
% ============================================================

nspan(1).
nspan(2).
nspan(3).

bottom(93).                  % lowest obstacle elevation (m)
frost_depth(2).              % frost protection depth (m)
hydraulic_opening(15).       % natural bank width at bottom elevation (m)
design_high_water_level(98.5).
approach_elevation(100).

% ============================================================
% Structural Loads and Roadway
% ============================================================

roadway_width(10).           % bridge deck width (m)

% bearing_x_load/1 is no longer a fixed value here -- it is computed once
% per solve_one run (abut_soil_config_8: estimate_bearing_x_load/2) from a
% preliminary dead+live load estimate at the initial bridge length, before
% the wall geometry that consumes it is designed. Declared dynamic there.

% ============================================================
% Unit Weights  (kN/m³)
% ============================================================

soil_gamma(20).              % retained soil unit weight
wall_gamma(24).              % concrete unit weight (used in pile fallback)

% ============================================================
% Retaining Wall Type Rules
% ============================================================

% All wall types available for general retainment
retaining_wall_type(concrete_gravity).
retaining_wall_type(mse_wall).
retaining_wall_type(timber_crib).
retaining_wall_type(gabion_block).
retaining_wall_type(sheet_piling).

% Wall types permitted when retainment reaches surface (integral abutment)
wall_type_at_surface(concrete_gravity).
wall_type_at_surface(timber_crib).

% Frost protection depth required per wall type (m)
frost_depth_for_wall(concrete_gravity, Df) :- frost_depth(Df).
frost_depth_for_wall(mse_wall,         0.4).
frost_depth_for_wall(timber_crib,      0.4).
frost_depth_for_wall(gabion_block,     0.4).
frost_depth_for_wall(sheet_piling,     0.4).

% Allowable settlement per wall type (mm)
allowable_settlement_for_wall(concrete_gravity, 25).
allowable_settlement_for_wall(mse_wall,         50).
allowable_settlement_for_wall(timber_crib,      50).
allowable_settlement_for_wall(gabion_block,     50).
allowable_settlement_for_wall(sheet_piling,     50).

% Fixed back-face offset (m) — walls where the back face is not equal to base width B.
% Absence of a fact means use full base width B.
wall_back_offset(mse_wall,     1.5).
wall_back_offset(sheet_piling, 1.5).

% Pile foundation fallback is permitted only for the listed wall types.
wall_pile_fallback(concrete_gravity).

% Walls with a wall_support_type/2 entry use the D/H embedment rule below
% instead of frost adjustment. Walls without one use frost_depth_for_wall
% for base geometry.

% ============================================================
% Sheet-Pile Embedment Sizing (D/H rule-of-thumb)
%
% Preliminary sizing only. These ratios come from widely used rules of
% thumb (free-earth/fixed-earth support method results, Rankine/Coulomb
% theory) and are a *starting point* -- final embedment depth must come
% from a proper earth-pressure analysis (or software such as DeepEX/
% SPW911) stamped by a geotechnical/structural engineer.
%
% wall_support_type(WallType, Support): only cantilever (unanchored)
% sheet-pile walls are modeled currently. Cantilever walls rely entirely
% on passive resistance below the dredge line, so they need much deeper
% embedment than an anchored/tied-back wall would; the anchored ratios
% below are recorded for when a tieback wall type is added.
% ============================================================

wall_support_type(sheet_piling, cantilever).

% soil_class_map(Type, Density, Class): maps borehole soil_log entries to
% the ratio-table categories. "medium" gravel is interpolated between
% loose and dense; rock is handled separately (refusal/keying, not a
% ratio-table class -- sheet piles don't drive deep into sound rock).
soil_class_map(gravel, loose,  loose_granular).
soil_class_map(gravel, medium, medium_granular).
soil_class_map(gravel, dense,  dense_granular).
soil_class_map(rock,   sound,  rock).
soil_class_map(clay,   soft,   soft_clay).
soil_class_map(clay,   medium, soft_clay).   % table groups "soft to medium clay" together
soil_class_map(clay,   stiff,  stiff_clay).

% d_h_ratio(Support, Class, Ratio): D = Ratio x H, H = retained/exposed
% height above the dredge line. Dense/loose granular and clay ranges per
% rule of thumb; loose sand pushed to the deep end of its range (lower
% friction angle, liquefaction/seepage risk); stiff clay kept close to
% the dense-granular ratio even when anchored, per the note that stiff
% clay is still weaker in passive resistance than dense sand.
d_h_ratio(cantilever, loose_granular,  2.0).   % cantilever, granular: 1.5-2.0 x H
d_h_ratio(cantilever, medium_granular, 1.75).
d_h_ratio(cantilever, dense_granular,  1.5).
d_h_ratio(cantilever, soft_clay,       2.5).   % cantilever, soft/medium clay: 2.0-3.0 x H (can run higher)
d_h_ratio(cantilever, stiff_clay,      2.0).
d_h_ratio(anchored,   loose_granular,  1.0).   % anchored, granular: 0.7-1.0 x H
d_h_ratio(anchored,   medium_granular, 0.85).
d_h_ratio(anchored,   dense_granular,  0.7).
d_h_ratio(anchored,   soft_clay,       1.25).  % anchored, soft clay: 1.0-1.5 x H
d_h_ratio(anchored,   stiff_clay,      1.75).

% Typical practice increases the ratio-derived depth by ~20% rather than
% trusting theoretical passive pressure at full value (passive pressure
% needs much more wall movement to mobilize than active pressure does).
embedment_fos_factor(1.2).

% Nominal key-in depth when the toe meets refusal on sound rock before
% reaching the theoretical ratio-based depth.
rock_key_depth(0.5).

% NOT modeled -- flagged for future work, since neither can be sized from
% a rule-of-thumb ratio alone:
%   - groundwater differential (unbalanced head across the wall is often
%     the single biggest driver of extra embedment)
%   - surcharge loads near the top of the wall
%   - base/heave stability check for soft clay (Terzaghi basal stability)

% Walls that serve as their own scour protection.
% Only rip rap is added as a supplementary scour element.
wall_is_scour_protection(sheet_piling).

% Scour mitigation methods permitted per wall type at river crossings.
% extend:     wall base is driven to scour depth below riverbed.
% sheet_pile: sheet piling added at wall toe; wall base stays at frost depth.
wall_scour_mitigation(concrete_gravity, extend).
wall_scour_mitigation(concrete_gravity, sheet_pile).
wall_scour_mitigation(mse_wall,         sheet_pile).
wall_scour_mitigation(timber_crib,      sheet_pile).
wall_scour_mitigation(gabion_block,     sheet_pile).
wall_scour_mitigation(gabion_block,     extend).

% ============================================================
% Pile Design Parameters
% ============================================================

pile_incl(4).               % inclination factor for inclined piles
pile_pmax(900).             % maximum allowable pile load (kN)
pile_hlat(80).             % maximum allowable lateral load per pile (kN)
pile_mc_threshold(180).     % Mc below which single-row centroid formula applies (kNm)

% lateral_group_multiplier(+SpacingInDiameters, -Multiplier)
% Reduction in group lateral resistance for closely spaced pile rows
% (shadowing effect): 3D->0.4, 4D->0.6, 5D->0.8, 6D(+)->1.0. Linear fit
% through those four points, clamped to [0, 1.0] -- group effects are
% taken to vanish beyond 6 diameters of row spacing.
lateral_group_multiplier(Ratio, Mult) :-
    Mult0 is 0.2 * Ratio - 0.2,
    Mult is max(0, min(1.0, Mult0)).

x1min(0.450).               % minimum front-edge pile offset from cap edge (m)

n1_range([4,6,8,10,12,14]). % candidate pile counts for row 1
n2_range([4,6,8,10,12]).    % candidate pile counts for row 2
n3_range([4,6,8,10,12]).    % candidate pile counts for row 3

% ============================================================
% Obstacle Type and Scour Parameters
% ============================================================

obstacle_type(river).           % river / road / railway
scour_depth(1.5).               % scour depth below riverbed (m)
sheet_pile_depth(4.0).          % sheet pile penetration below riverbed (m)
rip_rap_extent(5.0).            % rip rap extent from wall face (m)
allow_spill_through_at_river.   % permit spill-through at river crossings
