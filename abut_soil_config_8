% abut_soil_config_8
% Abutment soil configuration module.
% Builds a geometric profile from soil strata and sizes retaining elements.
%
% Soil facts format: soil(Type, Density, TopElev)
%
% TODO:
%   - if rock is close to lesser of frost depth or scour protection, add concrete base
%   -  add scour protection: extend bottom of wall, add concrete cushion, add sheet piling 
%   - expaned soil definition to include clays and presence of blocks

:- use_module(library(lists), [reverse/2]).
:- consult('site_facts').
:- consult('abut_config_facts').
:- consult('abut_pile_fallback').
:- consult('abut_print').
:- dynamic surface/1.
:- dynamic soil/3.
:- dynamic soil_log/3.
:- dynamic initial_depth/2.
:- dynamic bearing_x_load/1.
 

% ============================================================
% Helpers
% ============================================================

% strip_keys(+Pairs, -Values)
% Remove keys from a keysorted list of Key-Value pairs.
strip_keys([], []).
strip_keys([_-V | T], [V | TT]) :-
    strip_keys(T, TT).

% build_list(-SortedLayers)
% Collect soil/3 facts with Elev > bottom elevation, sort ascending (bottom to top).
% If no soil facts exist yet, generate them from soil_log/3 data.
build_list(L) :-
    bottom(BottomElev),
    findall(Elev-soil(Type, Density, Elev),
            (soil(Type, Density, Elev), Elev > BottomElev),
            Pairs),
    keysort(Pairs, Sorted),
    strip_keys(Sorted, L).

% assert_all_soil_logs
% Assert every soil_log/3 entry as a corresponding soil/3 fact.
assert_all_soil_logs :-
    forall(soil_log1(Type, Density, Elev),
           assertz(soil_log(Type, Density, Elev))).

% Convert soil_log/3 descriptions into soil/3 samples every 1.5 m.
% Samples run from the highest logged elevation down to frost_depth below
% the project bottom, ensuring coverage for all footing base elevations.
assert_soil_from_logs :-
    %retractall(soil(_, _, _)),
    findall(Elev-Type-Density, soil_log(Type, Density, Elev), Logs0),
    keysort(Logs0, LogsAsc),
    reverse(LogsAsc, LogsDesc),
    LogsDesc = [TopElev-_-_ | _],

    assert_soil_samples(TopElev, LogsDesc).


% assert_soil_samples(+Elev, +LogsDesc)
% Step down by 1.5 m, asserting one soil/3 fact per step.
% Stops when Elev drops below the lowest log entry elevation.
assert_soil_samples(Elev, Logs) :-
    last(Logs, StopElev-_-_),
    ( Elev >= StopElev ->
        soil_log_type_for_elev(Elev, Logs, Type, Density),
        assertz(soil(Type, Density, Elev)),
        NextElev is Elev - 1.5,
        assert_soil_samples(NextElev, Logs)
    ;   % stepped past StopElev without landing on it — assert one final entry there
        soil_log_type_for_elev(StopElev, Logs, Type, Density),
        assertz(soil(Type, Density, StopElev))
    ).

% soil_log_type_for_elev(+Elev, +LogsDesc, -Type, -Density)
% Scan the descending log list to find the stratum containing Elev.
% A stratum covers from its Top down to just above the next entry's Top.
soil_log_type_for_elev(Elev, [Top-Type-Density | Rest], Type, Density) :-
    Elev =< Top,
    ( Rest = [NextTop-_-_ | _] -> Elev > NextTop ; true ),
    !.
soil_log_type_for_elev(Elev, [_ | Rest], Type, Density) :-
    soil_log_type_for_elev(Elev, Rest, Type, Density).

% ============================================================
% Sheet-Pile Embedment Design (D/H rule-of-thumb)
%
% Preliminary sizing only -- see site_facts for the d_h_ratio/3 table,
% wall_support_type/2, and the caveats on what this does NOT account for
% (groundwater differential, surcharge, base/heave stability).
% ============================================================

% current_soil_logs_desc(-LogsDesc)
% Currently asserted soil_log/3 facts, sorted highest elevation first.
current_soil_logs_desc(LogsDesc) :-
    findall(Elev-Type-Density, soil_log(Type, Density, Elev), Logs0),
    keysort(Logs0, LogsAsc),
    reverse(LogsAsc, LogsDesc).

% soil_class_at_elev(+Elev, -Class)
% Ratio-table class of the stratum containing Elev.
soil_class_at_elev(Elev, Class) :-
    current_soil_logs_desc(LogsDesc),
    soil_log_type_for_elev(Elev, LogsDesc, Type, Density),
    soil_class_map(Type, Density, Class).

% rock_top_between(+BottomElev, +Depth, -RockTopElev)
% True when a logged rock stratum's top lies within the theoretical
% embedment zone (BottomElev down to BottomElev - Depth) -- i.e. the pile
% would meet refusal before reaching the ratio-derived depth.
rock_top_between(BottomElev, Depth, RockTopElev) :-
    current_soil_logs_desc(LogsDesc),
    member(RockTopElev-rock-_, LogsDesc),
    RockTopElev < BottomElev,
    RockTopElev >= BottomElev - Depth, !.

% capped_penetration_depth(+FromElev, +TheoreticalDepth, -ActualDepth)
%
% For POURED/GRAVITY foundations (a footing's frost-depth adjustment, or a
% gravity wall's "extend below scour depth" method) -- these CAN bear
% directly on rock, keyed in a nominal amount, so this caps rather than
% refuses. Three cases:
%   1. FromElev already sits on rock            -> nominal key-in depth only.
%   2. Rock's top lies within the theoretical
%      penetration zone (FromElev down to
%      FromElev - TheoreticalDepth)              -> stop at rock_key_depth
%                                                    past the rock surface.
%   3. No rock encountered in that zone          -> full TheoreticalDepth.
%
% Do NOT use this for sheet piling -- see sheet_pile_penetration_depth/3.
% A driven sheet pile cannot key into rock at all (nothing to predrill/
% socket into as a driven section would), unlike a footing that can simply
% bear on the rock surface.
capped_penetration_depth(FromElev, TheoreticalDepth, ActualDepth) :-
    soil_class_at_elev(FromElev, Class),
    ( Class == rock ->
        rock_key_depth(ActualDepth)
    ; rock_top_between(FromElev, TheoreticalDepth, RockTopElev) ->
        rock_key_depth(KeyDepth),
        ActualDepth is (FromElev - RockTopElev) + KeyDepth
    ;
        ActualDepth = TheoreticalDepth
    ).

% sheet_pile_penetration_depth(+FromElev, +TheoreticalDepth, -ActualDepth)
%
% Sheet piles are DRIVEN, not drilled or poured -- they cannot gain any
% embedment into rock at all (no nominal key-in like a footing, and
% rock-socketing/predrilling a sheet-pile section isn't a viable,
% economical option). If rock already sits at/above FromElev, or its top
% lies anywhere within the theoretical penetration zone, there is no valid
% sheet-pile design here -- fails outright rather than truncating.
% Used by wall_embedment_depth/4 (sheet-pile WALL) and sheet_pile_elem/3
% (sheet piling as SCOUR PROTECTION).
sheet_pile_penetration_depth(FromElev, TheoreticalDepth, TheoreticalDepth) :-
    soil_class_at_elev(FromElev, Class),
    Class \== rock,
    \+ rock_top_between(FromElev, TheoreticalDepth, _).

% wall_embedment_depth(+WallType, +BottomElev, +TopElev, -Dpenet)
% Sizes penetration depth below BottomElev (the dredge-line/site-bottom
% reference) as Ratio x H, H = TopElev - BottomElev (retained/exposed
% height), where Ratio depends on wall_support_type/2 and the soil class
% at BottomElev, plus a ~20% FOS margin (embedment_fos_factor/1). Fails
% (via sheet_pile_penetration_depth/3) if rock is encountered anywhere in
% the theoretical embedment zone, or if already founded on rock -- sheet
% piling simply isn't a valid wall type at that location; the caller backs
% off to try a different wall type from retaining_wall_type/1.
wall_embedment_depth(WallType, BottomElev, TopElev, Dpenet) :-
    wall_support_type(WallType, Support),
    H is TopElev - BottomElev,
    soil_class_at_elev(BottomElev, Class),
    d_h_ratio(Support, Class, Ratio),
    embedment_fos_factor(FOS),
    Theoretical is Ratio * H * FOS,
    sheet_pile_penetration_depth(BottomElev, Theoretical, Dpenet).

% retract_all_facts
% Retract all asserted dynamic facts, resetting to a clean state.
retract_all_facts :-
    retractall(surface(_)),
    retractall(initial_depth(_, _)),
    retractall(soil_log(_, _, _)),
    retractall(soil(_, _, _)).

% ============================================================
% Main Entry Point
% ============================================================

% abut_geom(-Profile, -PropElem)
%
% Steps:
%   1. Compile soil strata into a sorted layer list.
%   2. Derive geometric configuration per layer (vertical / slope / confined).
%   3. Compile structural elements from the profile.
%   4. Size / proportion structural elements.
%

parse_soil:-  
    retract_all_facts,
    assert_all_soil_logs,    
    initial_bridge_length(BridgeLength),
    initial_bearing_elevation(BridgeLength, BearingElev, DepthFromRatio),
    assert_soil_from_logs,
    echo_all_facts.

abut_geom(AbutElem, PropElem) :-
    build_list(L),
    initial_depth(_N, DepthFromRatio),
    bottom(BottomElev),
    iter_depth(L, BottomElev, none, [[BottomElev, bottom]], Profile, _Pcon, _Pslp),
    compile_elements(Profile, DepthFromRatio, AbutElem),
    design_elements(AbutElem, PropElem),
    writeln('designed embankment elements!'),
    print_solution_summary(PropElem),
    bridge_length(PropElem, BridgeLength2),
    format("Bridge length = ~1f m~n", [BridgeLength2]).


% initial_bridge_length(-BridgeLength)
initial_bridge_length(BridgeLength) :-
    approach_elevation(ApproachElev),
    bottom(BottomElev),
    hydraulic_opening(HO),
    BridgeLength is (ApproachElev - BottomElev) * 2 * 2 + HO - 6,
    format("initial bridge length = ~1f m~n", [BridgeLength]).

% estimate_girder_type(+SpanEstimate, -GirderType)
% First girder type (cheapest/lightest first, per girder_type/1's
% declaration order) that has any catalogue length reaching SpanEstimate.
% Used only to pick a representative unit weight for the preliminary load
% estimate below -- not a committed design choice.
estimate_girder_type(SpanEstimate, GirderType) :-
    girder_type(GirderType),
    girder_lengths(GirderType, L),
    L >= SpanEstimate,
    !.

% estimate_bearing_x_load(+N, +BridgeLength0)
% Preliminary bearing_x_load estimate, computed here (before the wall
% geometry that actually CONSUMES bearing_x_load is designed) from the
% rough initial bridge length rather than the final, wall-geometry-derived
% one -- this breaks the circular dependency between bearing_x_load
% (needed to size the wall) and the final span length (only known once
% the wall geometry itself is designed). Asserts the result over
% bearing_x_load/1 for the rest of this solve_one run to consume.
%
% TODO: dead load is factored at 1.2 (concrete) across the board for
% every girder type for now, including the steel portion of steel_beams
% and the asphalt wearing surface (not yet modeled) -- revisit once those
% are split out per-material (steel 1.1, concrete 1.2, asphalt 1.5).
estimate_bearing_x_load(N, BridgeLength0) :-
    SpanEstimate is BridgeLength0 / N,
    estimate_girder_type(SpanEstimate, GirderType),
    roadway_width(RW),
    n_girders(GirderType, RW, NGirders),
    girder_unit_weight(GirderType, UnitWeight),
    DeadLoad is UnitWeight * NGirders * SpanEstimate / 2,  % one abutment's share of one span
    live_load_abutment_reaction(SpanEstimate, _, _, LiveLoad),
    BLoad is 1.2 * DeadLoad + 1.7 * LiveLoad,
    retractall(bearing_x_load(_)),
    assertz(bearing_x_load(BLoad)),
    format("estimated bearing_x_load = ~2f kN (girder=~w, span est.=~1f m)~n",
           [BLoad, GirderType, SpanEstimate]).

% initial_bearing_elevation(+BridgeLength, -BearingElevation)
% Bearing elevation uses the larger of the high-water rule and span rule,
% and enforces a minimum value of 1.5.
initial_bearing_elevation(BridgeLength, BearingElev, DepthFromRatio) :-
    design_high_water_level(DHWL),
    nspan(N),
    DepthFromRatio is max(BridgeLength / (N * 30),1.5),
    format("initial bridge depth = ~1f m~n", [DepthFromRatio]),
    approach_elevation(ApproachElev),
    RawElev is ApproachElev-DepthFromRatio,
    BearingElev is max(DHWL + 0.3, RawElev),
    SurfaceElev is BearingElev + DepthFromRatio,
    format("SurfaceElev = ~1f m~n", SurfaceElev),
    asserta(initial_depth(N,DepthFromRatio)),
    asserta(surface(SurfaceElev)),    %to do hceck if exists and overwrite
    asserta(soil_log(gravel, dense,   SurfaceElev)).


% ============================================================
% Layer Configuration (bottom to top)
% ============================================================

% iter_depth(+Layers, +CurrElev, +PrevAType, +Accum, -Profile, -Pcon, -Pslp)
%
% Base case: all layers processed -- prepend the surface point.
% X coordinates and bearing offset are not assigned here.
iter_depth([], _, _, Accum, [[SurfaceElev, surface] | Accum], _Pcon, _Pslp) :-
    surface(SurfaceElev).

% Recursive case: classify one layer and advance.
iter_depth([soil(Type, _, Elev) | Tail], CurrElev, PrevAType, Accum, Profile, Pcon, Pslp) :-
    layer_config(Type, PrevAType, AType, Pcon, Pslp),
    iter_depth(Tail, Elev, AType, [[Elev, AType] | Accum], Profile, Pcon, Pslp).


% layer_config(+Type, +PrevAType, -AType, ?Pcon, ?Pslp)
%
% Rock is always vertical.
layer_config(rock, _, vertical, _, _).

% Gravel: classification depends on prior history flags (Pcon / Pslp).
layer_config(gravel, PrevAType, AType, Pcon, Pslp) :-
    (   Pcon == true, PrevAType == confined ->
            ( AType = slope ; AType = confined )

    ;   Pcon == true, PrevAType == slope ->
            AType = slope

    ;   Pslp == true, PrevAType == slope ->
            ( AType = slope ; AType = confined )

    ;   Pslp == true, PrevAType == confined ->
            AType = confined

    ;   % No prior history -- choose slope or confined and set the flag.
        ( AType = slope,    Pslp = true
        ; AType = confined, Pcon = true )
    ).


% ============================================================
% Structural Element Compilation
% ============================================================
%
% Element format: elem(Type, Bot_X, Bot_Elev, Top_X, Top_Elev, B, WallType)
%   X and B are uninstantiated at this stage; assigned by design_elements.
%
% compile_elements(+Profile, +DepthFromRatio, -AbutElem)
%   Profile:  top-down list of [Elev, Tag] produced by iter_depth.
%   AbutElem: bottom-to-top list of elem/7 with elevations set, X/B uninstantiated.

% Inspect the top two layer nodes to determine the bearing offset, create the
% stub element if needed, then delegate layer grouping to compile_layers.
compile_elements([[SurfaceElev, surface] | Rest], DepthFromRatio, AbutElem) :-
    ( Rest = [[_, slope], [_, slope] | _] ->
        Offset = 3.0
    ; Rest = [[_, slope], [_, AType2] | _], memberchk(AType2, [confined, vertical]) ->
        Offset = 1.5
    ;
        Offset = none
    ),
    ( Offset \= none ->
        frost_depth(Df),
        BearingElev is SurfaceElev - DepthFromRatio,
        Height      is Df / cos(atan(0.5)),
        BotElev     is BearingElev - Height,
        InitAcc = [elem(stub_abutment, bearing_offset(Offset), BotElev, _, BearingElev, _, none)]
    ;
        InitAcc = []
    ),
    compile_layers(Rest, none, InitAcc, AbutElem).

% compile_layers(+Profile, +Open, +Acc, -Elems)
%   Open = none | open(ElemType, TopElev)

% Bottom node with open element: close and return bottom-to-top list.
compile_layers([[BotElev, bottom]], open(EType, TopElev), Acc,
               [elem(EType, _, BotElev, _, TopElev, _, none) | Acc]).

% Bottom node with no open element.
compile_layers([[_, bottom]], none, Acc, Acc).

% Interior node, no open element: start new element.
compile_layers([[Elev, AType] | Rest], none, Acc, Elems) :-
    elem_type(AType, EType),
    compile_layers(Rest, open(EType, Elev), Acc, Elems).

% Interior node, same structural type: extend element downward.
compile_layers([[_Elev, AType] | Rest], open(EType, TopElev), Acc, Elems) :-
    elem_type(AType, EType), !,
    compile_layers(Rest, open(EType, TopElev), Acc, Elems).

% Interior node, different structural type: close current element, open new.
compile_layers([[Elev, AType] | Rest], open(EType, TopElev), Acc, Elems) :-
    ClosedElem = elem(EType, _, Elev, _, TopElev, _, none),
    elem_type(AType, NewEType),
    compile_layers(Rest, open(NewEType, Elev), [ClosedElem | Acc], Elems).


% ============================================================
% Scour Protection Helpers
% ============================================================

% is_pure_spill_through(+Acc)
% True when no retainment element has been accumulated yet
% (i.e. the configuration is embankment + stub only, with no wall below).
is_pure_spill_through(Acc) :-
    \+ member(elem(retainment, _, _, _, _, _, _), Acc).

% sheet_pile_elem(+BotX, +RiverbedElev, -Elem)
% Penetration uses sheet_pile_penetration_depth/3 (abut_soil_config_8) --
% a driven sheet pile cannot gain any embedment into rock, so this FAILS
% outright (rather than truncating) if rock blocks the full sheet_pile_depth.
% When that happens, wall types whose only permitted scour mitigation is
% sheet_pile (mse_wall, gabion_block, timber_crib -- see
% wall_scour_mitigation/2) simply have no valid design at this location,
% and the caller backs off to a wall type that supports "extend" instead.
sheet_pile_elem(BotX, RiverbedElev,
                elem(sheet_piling, BotX, BotElev, BotX, RiverbedElev, 0, none)) :-
    sheet_pile_depth(D),
    sheet_pile_penetration_depth(RiverbedElev, D, ActualD),
    BotElev is RiverbedElev - ActualD.

% rip_rap_elem(+RefX, +RiverbedElev, -Elem)
rip_rap_elem(RefX, RiverbedElev,
             elem(rip_rap, RefX, RiverbedElev, RefX, RiverbedElev, Extent, none)) :-
    rip_rap_extent(Extent).

% scour_mitigation(+BotElev, +BottomElev, +AdjBotX, +AdjBotElev,
%                  -DesignBotElev, -ScourElems)
%
% For river crossings where the wall base is at or below the riverbed:
%   Choice 1: extend wall to scour depth below riverbed + rip rap.
%   Choice 2: sheet piling to sheet_pile_depth below riverbed + rip rap.
% Otherwise (not a river, or wall is above riverbed): no-op.

scour_mitigation(_, BotElev, BottomElev, _, AdjBotElev, AdjBotElev, []) :-
    ( \+ obstacle_type(river) ; BotElev > BottomElev ), !.

% Rock forming the riverbed itself is inherently scour-resistant -- there's
% no erodible material above it to wash away, so no supplemental scour
% protection (rip rap, sheet piling, or extending the wall base) is needed
% for ANY wall type when the riverbed founds directly on rock. This is what
% makes wall types whose only method is sheet_pile (mse_wall, gabion_block,
% timber_crib) viable at rockD=0 -- they'd otherwise be blocked by an
% unachievable sheet-pile embedment (sheet_pile_penetration_depth/3)
% despite not actually needing scour protection at all.
scour_mitigation(_, _, BottomElev, _, AdjBotElev, AdjBotElev, []) :-
    obstacle_type(river),
    soil_class_at_elev(BottomElev, rock), !.

% "Extend" scour mitigation: penetration below the riverbed is capped via
% capped_penetration_depth/3 so the wall's base never gets driven into
% sound rock -- the same refusal constraint applied to sheet piling
% (wall_embedment_depth/4, sheet_pile_elem/3) applies here too.
scour_mitigation(WallType, _, BottomElev, AdjBotX, AdjBotElev, DesignBotElev, [RipRapElem]) :-
    obstacle_type(river),
    wall_scour_mitigation(WallType, extend),
    scour_depth(SD),
    capped_penetration_depth(BottomElev, SD, ActualSD),
    DesignBotElev is min(AdjBotElev, BottomElev - ActualSD),
    rip_rap_elem(AdjBotX, BottomElev, RipRapElem).

scour_mitigation(WallType, _, BottomElev, AdjBotX, AdjBotElev, AdjBotElev, [SheetElem, RipRapElem]) :-
    obstacle_type(river),
    wall_scour_mitigation(WallType, sheet_pile),
    sheet_pile_elem(AdjBotX, BottomElev, SheetElem),
    rip_rap_elem(AdjBotX, BottomElev, RipRapElem).

% ============================================================
% Element Geometry Design
% ============================================================
%
% design_elements(+AbutElem, -PropElem)
%   Processes elements bottom to top, assigning X coordinates, base widths,
%   and wall types. Embankment geometry is a 2H:1V slope (no structural design).
%   Retaining walls and stubs are sized by wall_design_or_piles.

% elem_below(+Acc, -BelowType)
% The structural type of the element directly below the current one.
elem_below([], bottom).
elem_below([elem(Type,_,_,_,_,_,_)|_], Type).

% prepend_if_any(+MaybeElem, +List, -Result)
% Prepends MaybeElem only when it is not 'none'.
prepend_if_any(none, List, List) :- !.
prepend_if_any(Elem, List, [Elem|List]).

design_elements(AbutElem, PropElem) :-
    design_elems(AbutElem, 0, [], PropElem).

% design_elems(+Remaining, +CurrX, +Acc, -PropElem)
%   CurrX: current river-face X (0 at bottom centre, increasingly negative outward).
%   Acc:   already-designed elements in bottom-to-top order.

design_elems([], _, Acc, Acc).

% Rock face: vertical, X unchanged.
design_elems([elem(rock_face, _, BotElev, _, TopElev, _, none) | Rest], CurrX, Acc, PropElem) :-
    Elem = elem(rock_face, CurrX, BotElev, CurrX, TopElev, 0, none),
    design_elems(Rest, CurrX, [Elem | Acc], PropElem).

% Embankment: 2H:1V slope; no structural design required.
design_elems([elem(embankment, _, BotElev, _, TopElev, _, none) | Rest], CurrX, Acc, PropElem) :-
    Height is TopElev - BotElev,
    TopX   is CurrX - 2 * Height,
    B      is 2 * Height,
    Elem   = elem(embankment, CurrX, BotElev, TopX, TopElev, B, none),
    design_elems(Rest, TopX, [Elem | Acc], PropElem).

% Retaining wall: frost adjustment, scour mitigation, structural design.
design_elems([elem(retainment, _, BotElev, _, TopElev, _, none) | Rest], CurrX, Acc, PropElem) :-
    elem_below(Acc, Below),
    ( Rest = [elem(embankment,_,_,_,_,_,_)|_] -> Above = embankment ; Above = none ),
    % Wall type: concrete gravity only if retainment reaches surface;
    % apply the bearing X vertical load only when THIS wall actually reaches
    % the surface (TopElev == SurfaceElev) -- i.e. it is itself the bearing
    % seat, with no separate stub_abutment above it. Checking WallType
    % membership in wall_type_at_surface/1 instead of the geometry directly
    % was a bug: concrete_gravity/timber_crib are also valid choices for
    % walls that stop at the BEARING elevation (with a stub above them
    % carrying the reaction), and were getting the full bearing_x_load
    % applied to them too even though they don't support it -- see the
    % "why does this wall on rock still need piles" investigation.
    surface(SurfaceElev),
    ( TopElev =:= SurfaceElev -> wall_type_at_surface(WallType) ; retaining_wall_type(WallType) ),
    ( TopElev =:= SurfaceElev -> bearing_x_load(BLoad) ; BLoad = 0 ),
    bottom(BottomElev),                                             %check if on slope or below river to define geometry
    ( wall_support_type(WallType, _) ->
        % Penetration-based wall (sheet piling): a cantilevered driven
        % section, not a gravity structure -- the D/H-ratio embedment
        % (site_facts: d_h_ratio/3) IS the complete design. It does NOT go
        % through the gravity-wall footing check (design_wall: overturning/
        % sliding/settlement/bearing on a B-wide base -- sheet piling has
        % no such footing) or pile fallback (rock-socketing/predrilling a
        % sheet-pile wall isn't viable, economical, unlike a drilled/driven
        % pile). Committed to via wall_support_type/2 (a plain fact check,
        % true for sheet_piling regardless of site conditions) BEFORE
        % calling wall_embedment_depth/4 as a required goal, not a
        % condition -- if the embedment fails (e.g. rock blocks it), the
        % whole clause fails instead of silently falling through to the
        % gravity-wall path below, which would give sheet piling a
        % physically meaningless designed base width.
        wall_embedment_depth(WallType, BottomElev, TopElev, Dpenet),
        AdjBotX       = CurrX,
        AdjBotElev    is BottomElev - Dpenet,
        DesignBotElev = AdjBotElev,
        ( wall_is_scour_protection(WallType), obstacle_type(river) ->
            rip_rap_elem(AdjBotX, BottomElev, RipRapElem),
            ScourElems = [RipRapElem]
        ;
            ScourElems = []
        ),
        ( wall_back_offset(WallType, X2off) -> ProcTopX is AdjBotX - X2off ; ProcTopX = AdjBotX ),
        Processed = elem(retainment, AdjBotX, DesignBotElev, ProcTopX, TopElev, 0, WallType),
        PilesElem = none
    ;
        % Other (gravity) wall types: frost adjustment then scour mitigation.
        % Frost penetration is capped via capped_penetration_depth/3 so it
        % never drives the wall's base into sound rock either -- the same
        % refusal constraint applied to sheet piling and "extend" scour.
        frost_depth_for_wall(WallType, Df),                         %frost depth per wall type
        Theta is atan(0.5),
        ( BotElev > BottomElev ->                                   %if gravity wall is above riverbed
            Theoretical is Df * cos(Theta),
            capped_penetration_depth(BotElev, Theoretical, ActualPen),
            AdjBotX    is CurrX - Df * sin(Theta),                  %plateau "a" for minimum d
            AdjBotElev is BotElev - ActualPen                       %depth "d" for minimum frost protection
        ;
            capped_penetration_depth(BotElev, Df, ActualPen),
            AdjBotX    = CurrX,                                     %if gravity wall is below riverbed
            AdjBotElev is BotElev - ActualPen
        ),
        % Apply scour mitigation for river crossings at or below riverbed.
        % Backtracks over permitted choices per wall type (wall_scour_mitigation/2).
        scour_mitigation(WallType, BotElev, BottomElev, AdjBotX, AdjBotElev, DesignBotElev, ScourElems),
        AdjHead = elem(retainment, AdjBotX, DesignBotElev, _, TopElev, _, WallType),
        %start wall design
        allowable_settlement_for_wall(WallType, AllowS),                %for type get allowable deflection TODO move to def page
        Dbx is 0.6,
        wall_design_or_piles(Above, _H, _B, _W, _E, AdjHead, Below, AllowS, BLoad, Dbx, Processed, PilesElem)
    ),
    % append a bearing_x element to calculate bridge length
    % a bearing "element" with seat below girder level at the base X - 0.6 m.
    initial_depth(_, DepthFromRatio),
    Processed = elem(_, ProcBotX, _, ProcTopX, _, _, _),
    ( TopElev =:= SurfaceElev ->
        BxBotX    is ProcBotX - 0.6,
        BxBotElev is SurfaceElev - DepthFromRatio,
        BearXElem = elem(bearing_x, BxBotX, BxBotElev, BxBotX, SurfaceElev, 0, none),
        BaseAcc = [BearXElem, Processed | Acc]
    ;
        BaseAcc = [Processed | Acc]
    ),
    prepend_if_any(PilesElem, BaseAcc, AccWithPiles),
    append(ScourElems, AccWithPiles, NewAcc),
    % ProcTopX (back face of designed wall) becomes the new river-face X for elements above.
    % Embankment above will start its base at ProcTopX and slope at 2H:1V from there.
    design_elems(Rest, ProcTopX, NewAcc, PropElem).

% Stub abutment: positioned at BearingX = CurrX (embankment/wall top) + bearing offset.
% bearing_offset(Offset) in the BotX field was placed there by compile_elements.
design_elems([elem(stub_abutment, bearing_offset(Offset), BotElev, _, TopElev, _, none) | Rest],
             CurrX, Acc, PropElem) :-
    BearingX is CurrX + Offset,
    StubHead = elem(stub_abutment, BearingX, BotElev, BearingX, TopElev, _, concrete_gravity),
    elem_below(Acc, Below),
    % Stub abutments are always concrete gravity; frost already applied in BotElev.
    allowable_settlement_for_wall(concrete_gravity, AllowS),
    bearing_x_load(BLoad),
    Dbx is -10,
    ( obstacle_type(river), is_pure_spill_through(Acc) ->
        allow_spill_through_at_river,
        SH is TopElev - BotElev,
        pile_fallback(none, SH, _SB, Below, BotElev, BLoad, Dbx,
                      StubHead, concrete_gravity, RawProcessed, PilesElem),
        RawProcessed = elem(stub_abutment, _, PBotElev, _, PTopElev, PB, PWT),
        PBotX is BearingX + PB / 2,
        PTopX is BearingX - PB / 2,
        Processed = elem(stub_abutment, PBotX, PBotElev, PTopX, PTopElev, PB, PWT),
        bottom(StubBottomElev),
        rip_rap_elem(PBotX, StubBottomElev, StubRipRap),
        ScourElems = [StubRipRap]
    ;
        wall_design_or_piles(none, _H, _B, _W, _E,
                             StubHead, Below, AllowS, BLoad, Dbx, RawProcessed, PilesElem),
        RawProcessed = elem(stub_abutment, _, PBotElev, _, PTopElev, PB, PWT),
        PBotX is BearingX + PB / 2,
        PTopX is BearingX - PB / 2,
        Processed = elem(stub_abutment, PBotX, PBotElev, PTopX, PTopElev, PB, PWT),
        ScourElems = []
    ),
    prepend_if_any(PilesElem, [Processed | Acc], AccWithPiles),
    append(ScourElems, AccWithPiles, NewAcc),
    design_elems(Rest, PBotX, NewAcc, PropElem).


% ============================================================
% Bridge Length
% ============================================================

% bridge_length(+PropElem, -Length)
%
% Total bridge length = hydraulic opening + 2 * XBearing, where:
%   XBearing = abs(BotX)              for a bearing_x element
%   XBearing = abs((RightX+LeftX)/2)  for a stub_abutment element
%
% BotX = 0 is taken as the centreline reference.
bridge_length(PropElem, Length) :-
    hydraulic_opening(HO),
    ( member(elem(bearing_x, BotX, _, _, _, _, _), PropElem) ->
        XBearing is abs(BotX)
    ; member(elem(stub_abutment, RightX, _, LeftX, _, _, _), PropElem) ->
        XBearing is abs((RightX + LeftX) / 2)
    ),
    Length is HO + 2 * XBearing.


