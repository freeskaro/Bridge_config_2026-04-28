% ============================================================
% Helpers
% ============================================================

% strip_keys(+Pairs, -Values)
% Remove keys from a keysorted list of Key-Value pairs.
strip_keys([], []).
strip_keys([_-V | T], [V | TT]) :-
    strip_keys(T, TT).

% build_list(-SortedLayers)
% Collect soil/3 facts with Elev > bottom elevation, sort ascending (bottom to top).
% If no soil facts exist yet, generate them from soil_log/3 data.
build_list(L) :-
    %( soil(_, _, _) -> true ; assert_soil_from_logs ),
    bottom(BottomElev),
    findall(Elev-soil(Type, Density, Elev),
            (soil(Type, Density, Elev), Elev > BottomElev),
            Pairs),
    keysort(Pairs, Sorted),
    strip_keys(Sorted, L).

% assert_soil_from_logs
% Convert soil_log/3 descriptions into soil/3 samples every 1.5 m.
% Samples run from the highest logged elevation down to frost_depth below
% the project bottom, ensuring coverage for all footing base elevations.
assert_soil_from_logs :-
    %retractall(soil(_, _, _)),
    findall(Elev-Type-Density, soil_log(Type, Density, Elev), Logs0),
    keysort(Logs0, LogsAsc),
    reverse(LogsAsc, LogsDesc),
    LogsDesc = [TopElev-_-_ | _],
    bottom(ProjBottom),
    frost_depth(Df),
    StopElev is ProjBottom - Df,
    assert_soil_samples(TopElev, StopElev, LogsDesc).

% assert_all_soil_logs
% Assert every soil_log/3 entry as a corresponding soil/3 fact.
assert_all_soil_logs :-
    forall(soil_log1(Type, Density, Elev),
           assertz(soil_log(Type, Density, Elev))).

% assert_soil_samples(+Elev, +StopElev, +LogsDesc)
% Step down by 1.5 m, asserting one soil/3 fact per step, until Elev < StopElev.
assert_soil_samples(Elev, StopElev, Logs) :-
    ( Elev >= StopElev ->
        soil_log_type_for_elev(Elev, Logs, Type, Density),
        assertz(soil(Type, Density, Elev)),
        NextElev is Elev - 1.5,
        assert_soil_samples(NextElev, StopElev, Logs)
    ;   true
    ).

% soil_log_type_for_elev(+Elev, +LogsDesc, -Type, -Density)
% Scan the descending log list to find the stratum containing Elev.
% A stratum covers from its Top down to just above the next entry's Top.
soil_log_type_for_elev(Elev, [Top-Type-Density | Rest], Type, Density) :-
    Elev =< Top,
    ( Rest = [NextTop-_-_ | _] -> Elev > NextTop ; true ),
    !.
soil_log_type_for_elev(Elev, [_ | Rest], Type, Density) :-
    soil_log_type_for_elev(Elev, Rest, Type, Density).

% echo_soil_facts
% Print all currently asserted soil(Type, Density, Elev) facts.
echo_soil_facts :-
    forall(soil(Type, Density, Elev),
           format('soil(~w, ~w, ~1f).~n', [Type, Density, Elev]) ).

% echo_all_facts
% Print all currently asserted dynamic facts.
echo_all_facts :-
    writeln('--- surface/1 ---'),
    forall(surface(Elev),
           format('surface(~1f).~n', [Elev])),
    writeln('--- initial_depth/2 ---'),
    forall(initial_depth(N, Depth),
           format('initial_depth(~w, ~1f).~n', [N, Depth])),
    writeln('--- soil_log/3 ---'),
    forall(soil_log(Type, Density, Elev),
           format('soil_log(~w, ~w, ~1f).~n', [Type, Density, Elev])),
    writeln('--- soil/3 ---'),
    forall(soil(Type, Density, Elev),
           format('soil(~w, ~w, ~1f).~n', [Type, Density, Elev])).

% retract_all_facts
% Retract all asserted dynamic facts, resetting to a clean state.
retract_all_facts :-
    retractall(surface(_)),
    retractall(initial_depth(_, _)),
    retractall(soil_log(_, _, _)),
    retractall(soil(_, _, _)).

% ============================================================
% Main Entry Point
% ============================================================

% abut_geom(-Profile, -PropElem)
%
% Steps:
%   1. Compile soil strata into a sorted layer list.
%   2. Derive geometric configuration per layer (vertical / slope / confined).
%   3. Compile structural elements from the profile.
%   4. Size / proportion structural elements.
%

parse_soil:-  
    retract_all_facts,
    assert_all_soil_logs,    
    initial_bridge_length(BridgeLength),
    initial_bearing_elevation(BridgeLength, BearingElev, DepthFromRatio),
    assert_soil_from_logs,
    echo_all_facts.

abut_geom(Profile, PropElem) :-
    build_list(L),
    initial_depth(N,DepthFromRatio),
    bottom(BottomElev),
    iter_depth(L, BottomElev, 0, none, [[0, BottomElev, bottom]], Profile, _Pcon, _Pslp),
    compile_elements(Profile, DepthFromRatio, _, _, AbutElem),
    design_retain(AbutElem, PropElem),
    writeln('designed embankment elements!'),
    print_solution_summary(PropElem),
    bridge_length(PropElem, BridgeLength2),
    format("Bridge length = ~1f m~n", [BridgeLength2]).


% initial_bridge_length(-BridgeLength)
initial_bridge_length(BridgeLength) :-
    approach_elevation(ApproachElev),
    bottom(BottomElev),
    hydraulic_opening(HO),
    BridgeLength is (ApproachElev - BottomElev) * 2 * 2 + HO - 6,
    format("initial bridge length = ~1f m~n", [BridgeLength]).

% initial_bearing_elevation(+BridgeLength, -BearingElevation)
% Bearing elevation uses the larger of the high-water rule and span rule,
% and enforces a minimum value of 1.5.
initial_bearing_elevation(BridgeLength, BearingElev, DepthFromRatio) :-
    design_high_water_level(DHWL),
    nspan(N),
    DepthFromRatio is max(BridgeLength / (N * 30),1.5),
    format("initial bridge depth = ~1f m~n", [DepthFromRatio]),
    approach_elevation(ApproachElev),
    RawElev is ApproachElev-DepthFromRatio,
    BearingElev is max(DHWL + 0.3, RawElev),
    SurfaceElev is BearingElev + DepthFromRatio,
    format("SurfaceElev = ~1f m~n", SurfaceElev),
    asserta(initial_depth(N,DepthFromRatio)),
    asserta(surface(SurfaceElev)),    %to do hceck if exists and overwrite
    asserta(soil_log(gravel, dense,   SurfaceElev)).


% ============================================================
% Layer Configuration (bottom to top)
% ============================================================

% iter_depth(+Layers, +CurrElev, +CurrX, +PrevAType, +Accum, -Profile, -Pcon, -Pslp)
%
% Base case: all layers processed -- append the surface point.
% If the top two layers are both slope, also append a bearing point at survey X + 3.
% If the top layer is slope and the second is confined/vertical, append a bearing point at survey X + 1.5.
iter_depth([], _, CurrX, _, Accum, Profile, _Pcon, _Pslp) :-
    surface(SurfaceElev),
    ( Accum = [[_, _, slope], [_, _, slope] | _] ->
        BearingX is CurrX + 3,
        Profile = [[CurrX, SurfaceElev, surface], [BearingX, SurfaceElev, bearing] | Accum]
    ; Accum = [[_, _, slope], [_, _, AType2] | _], memberchk(AType2, [confined, vertical]) ->
        BearingX is CurrX + 1.5,
        Profile = [[CurrX, SurfaceElev, surface], [BearingX, SurfaceElev, bearing] | Accum]
    ;
        Profile = [[CurrX, SurfaceElev, surface] | Accum]
    ).

% Recursive case: process one layer and advance.
iter_depth([soil(Type, _, Elev) | Tail], CurrElev, CurrX, PrevAType, Accum,
           Profile, Pcon, Pslp) :-
    Height is Elev - CurrElev,
    layer_config(Type, Height, CurrX, NewX, PrevAType, AType, Pcon, Pslp),
    NewAccum = [[NewX, Elev, AType] | Accum],
    iter_depth(Tail, Elev, NewX, AType, NewAccum, Profile, Pcon, Pslp).


% layer_config(+Type, +Height, +X1, -X2, +PrevAType, -AType, ?Pcon, ?Pslp)
%
% Rock is always vertical; X does not change.
layer_config(rock, _, X, X, _, vertical, _, _).

% Gravel: configuration depends on prior history flags (Pcon / Pslp).
layer_config(gravel, Height, X1, X2, PrevAType, AType, Pcon, Pslp) :-
    (   Pcon == true, PrevAType == confined ->
            ( AType = slope,    X2 is X1 - 2*Height
            ; AType = confined, X2 is X1 )

    ;   Pcon == true, PrevAType == slope ->
            ( AType = slope, X2 is X1 - 2*Height )

    ;   Pslp == true, PrevAType == slope ->
            ( AType = slope,    X2 is X1 - 2*Height
            ; AType = confined, X2 is X1 )

    ;   Pslp == true, PrevAType == confined ->
            ( AType = confined, X2 is X1 )

    ;   % No prior history -- choose slope or confined and set the flag.
        ( AType = slope,    X2 is X1 - 2*Height, Pslp = true
        ; AType = confined, X2 is X1,             Pcon = true )
    ).


% ============================================================
% Structural Element Compilation
% ============================================================
%
% Element format: elem(Type, Bot_X, Bot_Elev, Top_X, Top_Elev, B, WallType)
%   B        = base width (m)
%   WallType = retaining wall type (concrete_gravity|mse_wall|timber_crib|gabion_block)
%              set to 'none' for non-retainment elements during compilation;
%              assigned by design_retain_aux for retainment elements.
%
% compile_elements(+Profile, +DepthFromRatio, +PrevAType, +ElemAcc, -AbutElem)

% Surface node -- restart accumulator.
compile_elements([[_, _, surface] | ProfT], DepthFromRatio, _, _, AbutElem) :-
    compile_elements(ProfT, DepthFromRatio, _, [], AbutElem).

% Bearing node -- create a stub_abutment element centred at BearingX.
% 600 mm wide, top DepthFromRatio m below surface, height = frost_depth / cos(atan(0.5)).
compile_elements([[BearingX, SurfaceElev, bearing] | ProfT], DepthFromRatio, _, ElemAcc, AbutElem) :-
    frost_depth(Df),
    TopElev  is SurfaceElev - DepthFromRatio,
    Height   is Df / cos(atan(0.5)),
    BotElev  is TopElev - Height,
    RightX   is BearingX + 0.6,
    LeftX    is BearingX - 0.6,
    StubElem = elem(stub_abutment, RightX, BotElev, LeftX, TopElev, 0.6, none),
    compile_elements(ProfT, DepthFromRatio, _, ElemAcc, RestElem),
    append(RestElem, [StubElem], AbutElem).

% Bottom node -- finalise lowest element's bottom coordinates and compute B.
compile_elements([[BotX, BotElev, bottom]], _DepthFromRatio, _, ElemAcc, AbutElem) :-
    ( ElemAcc = [elem(E, _, _, TopX, TopElev, _, _) | Rest] ->
        ( E == embankment -> B is abs(TopX - BotX) ; B = 1.5 ),
        AbutElem = [elem(E, BotX, BotElev, TopX, TopElev, B, none) | Rest]
    ;   AbutElem = ElemAcc
    ).

% Interior node: open first element, extend same type, or transition to new type.
compile_elements([[X, Y, AType] | ProfT], DepthFromRatio, PrevAType, ElemAcc, AbutElem) :-
    ( ElemAcc = [] ->
        elem_type(AType, Elem),
        NewAcc = [elem(Elem, bot_x, _, X, Y, _, none)]
    ; PrevAType == AType ->
        ElemAcc = [elem(E, _, _, TopX, TopY, _, _) | ET],
        NewAcc  = [elem(E, X, Y, TopX, TopY, _, none) | ET]
    ;
        ElemAcc = [elem(EO, _, _, TopX, TopY, _, _) | ET],
        ( EO == embankment -> BEO is abs(TopX - X) ; BEO = 1.5 ),
        elem_type(AType, NewElem),
        NewAcc  = [elem(NewElem, bot_x, _, X, Y, _, none), elem(EO, X, Y, TopX, TopY, BEO, none) | ET]
    ),
    compile_elements(ProfT, DepthFromRatio, AType, NewAcc, AbutElem).


% ============================================================
% Retaining Wall Sizing
% ============================================================

% design_retain(+AbutElem, -PropElem)
design_retain(AbutElem, PropElem) :-
    design_retain_aux(AbutElem, [], RevPropElem),
    reverse(RevPropElem, PropElem).

design_retain_aux([], Acc, Acc).

design_retain_aux([Head | Tail], Acc, Result) :-
    Head = elem(Elem, BotX, BotElev, TopX, TopElev, _, _),
    ( Acc == []         -> Below = bottom                       %no element below thus bottom
    ; Acc = [Prev | _],  Prev = elem(Below, _, _, _, _, _, _)   %an element below record type in Below
    ),
    ( Elem == retainment ->                                     %if current element is type "retainement" then
        ( Tail == []          -> Above = none                   %if there is no elements after, it the top element, nothing above
        ; Tail = [Next | _],   Above = Next                     %otherwise next element is Above is Next
        ),
        % Wall type: concrete gravity only if retainment reaches surface;
        % otherwise any retaining wall type is valid.
        surface(SurfaceElev),
        ( TopElev =:= SurfaceElev ->
            wall_type_at_surface(WallType)
        ;
            retaining_wall_type(WallType)
        ),
        frost_depth_for_wall(WallType, Df),
        bottom(BottomElev),
        Theta is atan(0.5),
        ( BotElev > BottomElev ->                       %if gravity wall is above river bed
            AdjBotX    is BotX   - Df * sin(Theta),     %plateau "a" for minimum d
            AdjBotElev is BotElev - Df * cos(Theta)     %depth "d" for minimum frost protection
        ;
            AdjBotX    = BotX,                          %if gravity wall is below riverbed
            AdjBotElev is BotElev - Df
        ),
        AdjHead = elem(Elem, AdjBotX, AdjBotElev, TopX, TopElev, _, WallType),
        allowable_settlement_for_wall(WallType, AllowS),

        % Apply the bearing X vertical load when the retainment wall reaches the surface.
        ( TopElev =:= SurfaceElev ->
            bearing_x_load(BLoad)
        ;
            BLoad = 0
        ),
        wall_design_or_piles(Above, _H, _B, _W, _SumM, _E, AdjHead, Below, AllowS, BLoad, Processed, PilesElem),

        % If the retainment reaches the surface, append a bearing_x element:
        % a vertical stub from bearing level to surface at the base X - 0.6 m.
        Processed = elem(_, ProcBotX, _, _, _, _, _),
        ( TopElev  >= SurfaceElev ->
            BxBotX    is ProcBotX - 0.6,
            BxBotElev is SurfaceElev - 1.5,
            BearXElem = elem(bearing_x, BxBotX, BxBotElev, BxBotX, SurfaceElev, 0, none),
            NewAcc0 = [BearXElem, Processed | Acc]
        ;
            NewAcc0 = [Processed | Acc]
        ),
        % If piles were required, prepend the piles element so it follows
        % the wall body in the final (reversed) PropElem list.
        ( PilesElem \== none ->
            NewAcc = [PilesElem | NewAcc0]
        ;
            NewAcc = NewAcc0
        ),
        design_retain_aux(Tail, NewAcc, Result)

    ; Elem == stub_abutment ->
        ( Tail == []        -> Above = none
        ; Tail = [Next | _], Above = Next
        ),
        % Stub abutments are always concrete gravity; frost already in BotElev.
        allowable_settlement_for_wall(concrete_gravity, AllowS),
        bearing_x_load(BLoad),
        StubHead = elem(Elem, BotX, BotElev, TopX, TopElev, _, concrete_gravity),
        wall_design_or_piles(Above, _H, _B, _W, _SumM, _E,
                             StubHead, Below, AllowS, BLoad, RawProcessed, PilesElem),
        % wall_design_or_piles sets TopX = BotX - 1.5 (gravity wall convention).
        % For a stub abutment the base is symmetric: TopX = BotX - B.
        RawProcessed = elem(stub_abutment, PBotX, PBotElev, _, PTopElev, PB, PWT),
        PTopX is PBotX - PB,
        Processed = elem(stub_abutment, PBotX, PBotElev, PTopX, PTopElev, PB, PWT),
        ( PilesElem \== none ->
            NewAcc = [PilesElem, Processed | Acc]
        ;
            NewAcc = [Processed | Acc]
        ),
        design_retain_aux(Tail, NewAcc, Result)

    ;
        design_retain_aux(Tail, [Head | Acc], Result)
    ).


% ============================================================
% Bridge Length
% ============================================================

% bridge_length(+PropElem, -Length)
%
% Total bridge length = hydraulic opening + 2 * XBearing, where:
%   XBearing = abs(BotX)              for a bearing_x element
%   XBearing = abs((RightX+LeftX)/2)  for a stub_abutment element
%
% BotX = 0 is taken as the centreline reference.
bridge_length(PropElem, Length) :-
    hydraulic_opening(HO),
    ( member(elem(bearing_x, BotX, _, _, _, _, _), PropElem) ->
        XBearing is abs(BotX)
    ; member(elem(stub_abutment, RightX, _, LeftX, _, _, _), PropElem) ->
        XBearing is abs((RightX + LeftX) / 2)
    ),
    Length is HO + 2 * XBearing.


% ============================================================
% Solution Summary
% ============================================================

% print_solution_summary(+PropElem)
%
% Writes a human-readable bullet list of each element: type,
% bottom/top elevations, base width (except embankment), and
% for pile elements: piles per row and row spacing.

print_solution_summary(PropElem) :-
    writeln('Elements:'),
    maplist(print_elem_line, PropElem).

% Pile element: elem(piles, RowCounts, Spacings, none, none, none, none)
print_elem_line(elem(piles, RowCounts, Spacings, _, _, _, _)) :-
    format("  - piles:~n"),
    print_pile_rows(1, RowCounts, Spacings).

print_pile_rows(_, [], _).
print_pile_rows(I, [N|Ns], [X|Xs]) :-
    format("      row ~w: ~w piles at ~2f m~n", [I, N, X]),
    I1 is I + 1,
    print_pile_rows(I1, Ns, Xs).

% Embankment: no B
print_elem_line(elem(embankment, _, BotElev, _, TopElev, _, _)) :-
    format("  - embankment: elev ~2f to ~2f m~n", [BotElev, TopElev]).

% All other elements: elem(Type, BotX, BotElev, TopX, TopElev, B, WallType)
print_elem_line(elem(Type, _, BotElev, _, TopElev, B, _)) :-
    Type \== piles, Type \== embankment,
    format("  - ~w: elev ~1f to ~1f m, B = ~2f m~n",
           [Type, BotElev, TopElev, B]).